{
  "manifest_version": 3,
  "name": "Text Analyzer",
  "version": "1.0",
  "description": "Analyze selected text using configured AI providers",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "offscreen"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": [
    "https://api.murf.ai/*",
    "https://api.openai.com/*",
    "https://translate.google.com/*",
    "http://localhost:11434/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "all_frames": true
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["dist/youtube-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' *.oaiusercontent.com blob: https://cdn.openai.com https://persistent.oaistatic.com https://murf.ai https://translate.google.com;"
  }
}
